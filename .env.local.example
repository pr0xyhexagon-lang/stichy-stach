# --- Google Sheets (service account) ---
# The service account's email (from the JSON key: "client_email")
GOOGLE_SERVICE_ACCOUNT_EMAIL=stichy-stash@your-project.iam.gserviceaccount.com
# The private key (from the JSON key: "private_key"). Keep the quotes and the \n characters.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=

# --- Admin login ---
ADMIN_PASSWORD=change-me
# Any long random string (32+ chars). e.g. run: openssl rand -hex 32
SESSION_SECRET=

# --- Optional ---
# Timezone for "today" dates (default Asia/Colombo)
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Colombo
# Set to 1 to use a local JSON file (.data/mock-sheet.json) instead of Google — for trying the app only
# SHEETS_MOCK=1
